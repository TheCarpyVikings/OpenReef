{
  "name": "openreef-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "capture": "node tools/capture-demos.mjs",
    "demo:fixtures": "python3 tools/demo-fixtures.py",
    "demo:record": "node tools/demo-record.mjs",
    "demo:smoke": "node tools/demo-smoke.mjs",
    "panel:mobile-audit": "node tools/panel-mobile-audit.mjs",
    "demo:refresh": "python3 tools/demo-fixtures.py && npm run build && node tools/demo-smoke.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "meshoptimizer": "^1.3.0",
    "postprocessing": "^6.39.5",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.7.0",
    "draco3dgltf": "^1.5.9",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "pnpm": {
    "overrides": {
      "@donmccurdy/caporal>glob": "^14.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
