# OpenReef beta portal — environment
#
# Copy to .env.local for development; set the same keys as Vercel project
# environment variables for production. Never commit real values.

# --- Supabase --------------------------------------------------------------
# Project URL and anon key: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypasses RLS, and every table in this schema denies anon
# and authenticated outright, so this is what actually reads and writes data.
# Server-side only. If this leaks, rotate it immediately: it is full access to
# every tester's feedback and support summary.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Access ----------------------------------------------------------------
# Comma-separated allowlist of addresses that may use the admin UI. Anyone can
# hold a Supabase session; only these addresses are the owner. An empty value
# fails closed and locks everyone out.
OWNER_EMAILS=thecarpyvikings@gmail.com

# --- Marketing site --------------------------------------------------------
# Origin allowed to POST /api/signup (the only browser-called route).
SITE_ORIGIN=https://openreef.co.uk
